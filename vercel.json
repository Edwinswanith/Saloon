{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "HUSKY=0 npm ci && pip install -r backend/requirements.txt",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/app.py" },
    { "source": "/i/:path*", "destination": "/backend/app.py" },
    { "source": "/invoice/:path*", "destination": "/backend/app.py" },
    { "source": "/feedback", "destination": "/backend/app.py" },
    { "source": "/feedback/:path*", "destination": "/backend/app.py" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}

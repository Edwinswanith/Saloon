# =============================================================================
# Saloon — single environment file (project root)
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Backend: database ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Saloon
MONGODB_DB=Saloon_prod

# --- Backend: auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# --- Backend: server ---
# Dev default 5000; Cloud Run sets PORT=8080 automatically
PORT=5000
FLASK_APP=app.py
FLASK_ENV=development

# --- Backend: optional services ---
# Redis cache (omit to use in-memory cache)
# REDIS_URL=redis://localhost:6379/0

# WhatsApp Business API (omit for dev/placeholder mode)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Business name shown when no settings record exists yet
BUSINESS_NAME=Priyanka Nature Cure

# --- Frontend ↔ backend linking (Vite reads VITE_* at build/dev time) ---
# Local dev: backend on 5000, frontend dev server on 5173
VITE_API_BASE_URL=http://127.0.0.1:5000

# Public URL for invoice/share links (WhatsApp, SMS). Production: your deployed URL.
VITE_PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- Vercel (single domain: SPA + Flask API) ---
# Dashboard → Project Settings:
#   Root Directory: ./
#   Build Command: npm run vercel-build
#   Install Command: HUSKY=0 npm ci
#   (Vercel's Python builder auto-installs backend/requirements.txt itself —
#    a manual `pip install` here fails on Vercel's uv-managed Python image
#    with "externally-managed-environment")
#   Output Directory: (leave empty — static files go to public/ via vercel-build)
# Environment variables (Production):
#   MONGODB_URI, MONGODB_DB, JWT_SECRET
# Leave VITE_API_BASE_URL unset in Vercel — vercel-build builds with empty URL so
# production web uses window.location.origin (same-origin /api/...).

# --- Production example (Cloud Run — legacy) ---
# VITE_API_BASE_URL=https://saloon-management-system-895210689446.europe-west2.run.app
# VITE_PUBLIC_BASE_URL=https://saloon-management-system-895210689446.europe-west2.run.app
# FLASK_ENV=production

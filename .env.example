# =============================================================================
# Saloon — single environment file (project root)
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Backend: database ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Saloon
MONGODB_DB=Saloon_prod

# --- Backend: auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# --- Backend: server ---
# Dev default 5000; Cloud Run sets PORT=8080 automatically
PORT=5000
FLASK_APP=app.py
FLASK_ENV=development

# --- Backend: optional services ---
# Redis cache (omit to use in-memory cache)
# REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Cloud API. Keep every value server-side.
META_GRAPH_API_VERSION=
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_APP_SECRET=
META_WA_WEBHOOK_VERIFY_TOKEN=
# JSON: [{"id":"tester","label":"Owner test","phone":"+919999999999","opted_in":true}]
META_WA_TEST_RECIPIENTS_JSON=
META_WA_RATE_LIMIT_PER_MINUTE=3
META_WA_RATE_LIMIT_PER_DAY=20
META_WA_GLOBAL_RATE_LIMIT_PER_DAY=50

# Production sending remains disabled until each prerequisite is verified.
WHATSAPP_PRODUCTION_BILLING_VERIFIED=false
WHATSAPP_PRODUCTION_WEBHOOK_VERIFIED=false
WHATSAPP_PRODUCTION_TEST_ENABLED=false
WHATSAPP_PRODUCTION_SEND_ENABLED=false

# Private Cloudflare R2 storage. Production must use a non-demo bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Business name shown when no settings record exists yet
BUSINESS_NAME=Priyanka Nature Cure

# Demo/client showcase safety. Leave blank to disable.
# Set DEMO_BRANCH_ID to the MongoDB ObjectId of your dummy/demo branch.
# Staff/managers assigned to this branch are automatically locked to it.
# Use the optional comma-separated lists for demo owner accounts or any account
# that is not assigned directly to the demo branch.
DEMO_BRANCH_ID=
DEMO_USER_IDS=
DEMO_USER_EMAILS=
DEMO_USER_MOBILES=

# Google Business Profile review link, shown to customers after a 4-5 star rating
# (public feedback page) and to staff in the admin Feedback screen.
# Get it from Google Business Profile > Ask for reviews > Copy link, or build one from
# your Place ID: https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
# Leave blank to keep only the "Maybe Later" button.
GOOGLE_REVIEW_URL=
VITE_GOOGLE_REVIEW_URL=

# --- Frontend ↔ backend linking (Vite reads VITE_* at build/dev time) ---
# Local dev: backend on 5000, frontend dev server on 5173
VITE_API_BASE_URL=http://127.0.0.1:5000

# Public URL for invoice/share links (WhatsApp, SMS). Production: your deployed URL.
VITE_PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- Vercel (single domain: SPA + Flask API) ---
# Dashboard → Project Settings:
#   Root Directory: ./
#   Build Command: npm run vercel-build
#   Install Command: HUSKY=0 npm ci
#   (Vercel auto-installs Python deps from root requirements.txt for api/index.py)
#   Output Directory: (leave empty — static files go to public/ via vercel-build)
# Environment variables (Production):
#   MONGODB_URI, MONGODB_DB, JWT_SECRET
# Leave VITE_API_BASE_URL unset in Vercel — vercel-build builds with empty URL so
# production web uses window.location.origin (same-origin /api/...).

# --- Production example (Cloud Run — legacy) ---
# VITE_API_BASE_URL=https://saloon-management-system-895210689446.europe-west2.run.app
# VITE_PUBLIC_BASE_URL=https://saloon-management-system-895210689446.europe-west2.run.app
# FLASK_ENV=production
